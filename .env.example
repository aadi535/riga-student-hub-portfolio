# Copy to .env locally. Enter secrets through your host's secret settings for production.
DATABASE_URL=jdbc:postgresql://localhost:5432/studenthub
DATABASE_USERNAME=studenthub
DATABASE_PASSWORD=replace-with-a-long-random-password
MANAGER_USERNAME=manager
# BCrypt hash only; never put a plaintext manager password here.
# For Docker Compose, wrap the BCrypt value in single quotes to preserve its dollar signs.
MANAGER_PASSWORD_HASH='replace-with-bcrypt-hash'
RATE_LIMIT_SALT=replace-with-at-least-32-random-characters
COOKIE_SECURE=true
PUBLIC_URL=https://your-app.onrender.com
ALLOWED_ORIGIN=https://your-app.onrender.com
NOTIFICATION_TO=
# Resend requires a verified sender. Sandbox sender can email only the account owner.
NOTIFICATION_FROM=
RESEND_API_KEY=
NOTIFICATIONS_ENABLED=true
